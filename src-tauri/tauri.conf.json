{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sefarya",
  "mainBinaryName": "sefarya",
  "version": "0.1.0",
  "identifier": "io.github.yacovdroridev.sefarya",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ספריא – לימוד גמרא",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Education",
    "shortDescription": "לימוד גמרא עם רש\"י, תוספות ומראי מקומות מספריא",
    "longDescription": "Linux desktop client for Sefaria focused on Talmud study: Gemara with Rashi and Tosafot side by side, Ein Mishpat, Torah Or, Mesorat HaShas, other commentaries, adjustable fonts, offline cache and Daf Yomi video lessons.",
    "homepage": "https://github.com/yacovdroridev/sefarya",
    "publisher": "yacovdroridev",
    "copyright": "Code: MIT. Texts: Sefaria, per-version licenses.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["yt-dlp"],
        "section": "education"
      }
    }
  }
}
